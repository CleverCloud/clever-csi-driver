{
  "type": "object",
  "properties": {
    "driverName": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]+$",
      "maxLength": 63
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "pullPolicy": {
          "enum": [
            "IfNotPresent",
            "Always",
            "Never"
          ]
        }
      }
    },
    "controller": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "ownershipConfirmed": {
          "type": "boolean"
        },
        "clusterId": {
          "type": "string"
        },
        "organisationId": {
          "type": "string"
        },
        "axoUrl": {
          "type": "string",
          "pattern": "^https://[^ ]+$"
        },
        "existingSecret": {
          "type": "string",
          "minLength": 1
        },
        "tokenKey": {
          "type": "string",
          "minLength": 1
        },
        "sidecars": {
          "type": "object",
          "properties": {
            "attacher": {
              "type": "boolean"
            },
            "provisioner": {
              "type": "boolean"
            },
            "resizer": {
              "type": "boolean"
            },
            "snapshotter": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "node": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "idFile": {
          "type": "string",
          "pattern": "^/[A-Za-z0-9_./-]+$"
        },
        "stateDirectory": {
          "type": "string",
          "pattern": "^/[A-Za-z0-9_./-]+$"
        },
        "kubeletDirectory": {
          "type": "string",
          "pattern": "^/[A-Za-z0-9_./-]+$"
        },
        "poolLabel": {
          "type": "string",
          "minLength": 1
        },
        "poolValue": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 181
    }
  },
  "$schema": "https://json-schema.org/draft-07/schema#"
}
